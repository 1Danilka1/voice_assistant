# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather in Telegram
BOT_TOKEN=

# ── OpenAI (Whisper speech-to-text) ───────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic (Claude AI brain) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── iCloud Calendar (syncs to your iPhone) ────────────────────────────────────
# Your Apple ID email
ICLOUD_USERNAME=
# App-specific password: appleid.apple.com → Sign-In & Security → App-Specific Passwords
ICLOUD_PASSWORD=

# ── Telegram User Client (for sending messages as YOU) ────────────────────────
# Get from https://my.telegram.org → Apps → Create new application
TG_API_ID=
TG_API_HASH=

# ── General ───────────────────────────────────────────────────────────────────
# Your timezone: Europe/Moscow, Europe/Kyiv, Asia/Almaty, Europe/London, etc.
TIMEZONE=Europe/Warsaw

# ── Database path (override for cloud deploys with mounted volume) ────────────
# Locally: leave default. On Railway with a volume at /data: DB_PATH=/data/assistant.db
DB_PATH=assistant.db
